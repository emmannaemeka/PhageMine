{% set name = "phagemine" %}
{% set version = "1.3.0" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  url: https://github.com/emmannaemeka/PhageMine/archive/refs/tags/v{{ version }}.tar.gz
  sha256: 43f557bbd7a90370fffef65f730d5b6136111244fe7a8081ce91ef22271ec86e

build:
  number: 0
  noarch: python
  script: python -m pip install . --no-deps --no-build-isolation -vv
  run_exports:
    - {{ pin_subpackage('phagemine', max_pin="x") }}
  entry_points:
    - phagemine = phagemine.cli:main
    - phagemine-gui = phagemine.gui.launcher:main

requirements:
  host:
    - python >=3.10
    - pip
    - setuptools >=68,<81
    - wheel
  run:
    - python >=3.10
    - setuptools <81
    - biopython >=1.85,<2
    - psutil >=5,<8
    - matplotlib-base >=3.7,<4
    - pyhmmer >=0.10,<0.13
    - pyrodigal =3.7.1
    - pyrodigal-gv =0.3.2
    - pyrodigal-rv =0.1.0
    - phanotate =1.6.7
    - prodigal =2.6.3
    - hmmer =3.4
    - mmseqs2
    - diamond
    - mash =2.3
    - blast
    - trnascan-se =2.0.12

test:
  imports:
    - phagemine
    - phagemine.rna_features
    - phagemine.curation
  commands:
    - phagemine --version
    - phagemine --help
    - phagemine rna --help
    - phagemine curate --help

about:
  home: https://github.com/emmannaemeka/PhageMine
  dev_url: https://github.com/emmannaemeka/PhageMine
  doc_url: https://github.com/emmannaemeka/PhageMine/blob/main/docs/installation.md
  summary: Evidence-first bacteriophage genome annotation and comparative genomics
  license: MIT
  license_file: LICENSE

extra:
  recipe-maintainers:
    - emmannaemeka
