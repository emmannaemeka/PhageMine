{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent validation panel metadata",
  "type": "object",
  "required": ["validation_unit_id", "accession_version", "sequence_sha256", "status"],
  "properties": {
    "validation_unit_id": {"type": "string", "pattern": "^IV[0-9]{4,}$"},
    "accession_version": {"type": "string", "minLength": 1},
    "sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["CANDIDATE", "INCLUDED", "EXCLUDED"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "architecture_stratum": {"type": ["string", "null"]},
    "database_overlap_class": {"enum": ["EXACT_REFERENCE_OVERLAP", "CLOSE_HOMOLOG_OVERLAP", "REMOTE_HOMOLOGY", "NO_SIGNIFICANT_REFERENCE", "UNKNOWN_DATABASE_RELATIONSHIP", null]},
    "reference_quality": {"enum": ["TIER_1_EXPERIMENTALLY_ESTABLISHED", "TIER_2_EXPERT_CURATED", "TIER_3_STRONGLY_ORTHOLOGY_SUPPORTED", "TIER_4_COMPUTATIONALLY_SUPPORTED", "UNRESOLVED", "NOT_EVALUABLE", null]}
  },
  "additionalProperties": true
}
